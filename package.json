{
  "name": "octopulse",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "deploy-cloudflare": "NITRO_PRESET=cloudflare_module npm run build && npx wrangler deploy && npx wrangler d1 migrations apply DB --remote",
    "deploy-vercel": "npx vercel deploy",
    "postinstall": "nuxt prepare && simple-git-hooks && pnpm db:generate",
    "db:generate": "nuxt db generate",
    "db:migrate": "nuxt db migrate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.81",
    "@libsql/client": "^0.15.15",
    "@nuxthub/core": "^0.10.1",
    "@pinia/colada": "^0.18.1",
    "@pinia/colada-nuxt": "0.2.4",
    "@unocss/nuxt": "66.5.10",
    "@vueuse/core": "^14.1.0",
    "@vueuse/nuxt": "14.1.0",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "nuxt": "^4.2.2",
    "pinia": "^3.0.4",
    "temporal-polyfill": "^0.3.0",
    "unstorage": "^1.17.3",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.1",
    "@nuxt/eslint": "^1.12.1",
    "@nuxtjs/color-mode": "^4.0.0",
    "@pinia/nuxt": "^0.11.3",
    "eslint-plugin-format": "^1.1.0",
    "lint-staged": "^16.2.7",
    "nuxt-auth-utils": "^0.5.26",
    "reka-ui": "^2.6.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "unocss": "^66.5.10",
    "wrangler": "^4.54.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
