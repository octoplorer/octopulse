    "@vueuse/core": "15.0.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.12",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.11.0",
    "eslint-plugin-format": "2.0.1",
    "typescript": "6.0.3",
    "unocss": "66.10.5",
    "vite": "8.3.2",
