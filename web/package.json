{
  "name": "@octopulse/web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "generate": "openapi-ts",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "aube --workspace-root run --no-install lint",
    "lint:fix": "aube --workspace-root run --no-install lint:fix",
    "format": "aube --workspace-root run --no-install lint:fix",
    "format:check": "aube --workspace-root run --no-install lint"
  },
  "dependencies": {
    "@ark-ui/vue": "5.39.2",
    "@pinia/colada": "1.4.6",
    "@pinia/colada-plugin-auto-refetch": "0.2.7",
    "@tanstack/vue-form": "1.33.5",
    "@unhead/vue": "3.4.2",
    "@vueuse/core": "15.0.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.12",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@iconify-json/lucide": "1.2.138",
    "@vitejs/plugin-vue": "6.0.9",
    "unocss": "66.10.5",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.11"
  }
}
